-- Loads the VFX kit's effect meshes (batch 2: slash arc, shock ring, spiral rings, twister) into
-- ReplicatedStorage.VfxMeshes so clients can clone them. Each is an uploaded Model (VfxPicks.meshes,
-- generated by scripts/vfx-apply from assets/vfx/meshes.json), loaded with InsertService:LoadAsset:
-- MeshParts are never created from script. A mesh that is not uploaded, or fails to load, is left
-- out (one warning); nothing draws with these meshes yet. Presentation only.

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VfxPicks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VfxPicks"))

local VfxMeshes = {}

function VfxMeshes.start()
	local folder = Instance.new("Folder")
	folder.Name = "VfxMeshes"
	folder.Parent = ReplicatedStorage
	local meshes = (VfxPicks :: any).meshes or {}
	task.spawn(function()
		local loaded, failed = 0, {}
		for name, id in meshes do
			local ok, result = pcall(InsertService.LoadAsset, InsertService, id)
			-- LoadAsset wraps the asset in a Model; the mesh is its first child.
			local mesh = if ok and result then result:FindFirstChildWhichIsA("BasePart", true) else nil
			if mesh then
				mesh.Name = name
				mesh.Anchored = true
				mesh.CanCollide = false
				mesh.CanQuery = false
				mesh.CanTouch = false
				mesh.Parent = folder
				loaded += 1
			else
				table.insert(
					failed,
					string.format("%s (%d): %s", name, id, if ok then "no mesh part" else tostring(result))
				)
			end
			if ok and result then
				result:Destroy()
			end
		end
		if #failed > 0 then
			warn("[VfxMeshes] not loaded: " .. table.concat(failed, ", "))
		elseif loaded > 0 then
			print(string.format("[VfxMeshes] %d effect meshes in ReplicatedStorage.VfxMeshes", loaded))
		end
	end)
end

return VfxMeshes
