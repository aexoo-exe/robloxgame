-- Fixed-seed fights with the current roster, used by RegressionTest to check that engine changes
-- leave existing fights exactly as they were. The stored fingerprints were last regenerated when
-- roster v1.1 replaced the old roster. Each fight is a seeded random full-roster board per
-- side (7 units, star levels 1-3); odd seeds apply trait bonuses, even seeds do not.
-- Fingerprint: SHA-256 of the winner, end tick, survivors and every event (keys sorted).
-- Regenerate the stored fingerprints only on purpose: lune run tests/RegressionFights.luau print
-- To see which fights changed and whether each one has a unit with forms (the only fights a form
-- change should touch): lune run tests/RegressionFights.luau check

local serde = require("@lune/serde")

local CombatSim = require("../src/shared/CombatSim")
local SeededRandom = require("../src/shared/SeededRandom")
local Traits = require("../src/shared/Traits")
local UnitConfig = require("../src/shared/UnitConfig")

local RegressionFights = {}

RegressionFights.count = 60

local function boards(seed: number)
	local names = {}
	for name in UnitConfig do
		table.insert(names, name)
	end
	table.sort(names)
	local rng = SeededRandom.new(seed)
	local result = { {}, {} }
	for side = 1, 2 do
		local used = {}
		for i = 1, 7 do
			local column, row
			repeat
				column, row = SeededRandom.nextInt(rng, 7), SeededRandom.nextInt(rng, 4)
			until not used[column .. "," .. row]
			used[column .. "," .. row] = true
			table.insert(result[side], {
				id = side .. ":" .. i,
				unitType = names[SeededRandom.nextInt(rng, #names)],
				starLevel = SeededRandom.nextInt(rng, 3),
				column = column,
				row = row,
			})
		end
	end
	return result
end

local function serialize(value): string
	if type(value) ~= "table" then
		return tostring(value)
	end
	local keys = {}
	for key in value do
		table.insert(keys, tostring(key))
	end
	table.sort(keys)
	local parts = {}
	for _, key in keys do
		local item = value[key]
		if item == nil then
			item = value[tonumber(key)]
		end
		table.insert(parts, key .. "=" .. serialize(item))
	end
	return "{" .. table.concat(parts, ",") .. "}"
end

-- Runs fight `seed` and returns its fingerprint.
function RegressionFights.fingerprint(seed: number): string
	local sides = boards(seed)
	local withTraits = seed % 2 == 1
	local startBonuses, traitSetups = Traits.combatParams(sides[1], sides[2])
	local result = CombatSim.run({
		boards = sides,
		columns = 7,
		rows = 4,
		unitTypes = UnitConfig,
		ticksPerSecond = 20,
		maxTicks = 20 * 50,
		timeoutDrawMargin = 0.01,
		seed = seed,
		startBonuses = if withTraits then startBonuses else nil,
		traits = if withTraits then traitSetups else nil,
	})
	local text = serialize({
		winner = result.winner,
		endTick = result.endTick,
		survivors = result.survivors,
		events = result.events,
	})
	return serde.hash("sha256", text)
end

-- True if fight `seed` has a unit whose type lists forms.
function RegressionFights.hasForms(seed: number): boolean
	for _, board in boards(seed) do
		for _, placed in board do
			if UnitConfig[placed.unitType].forms then
				return true
			end
		end
	end
	return false
end

-- Run directly: "print" prints the stored-fingerprints module for the current engine; "check" lists
-- the fights that no longer match it and fails if any of them has no unit with forms.
if not script then
	local process = require("@lune/process")
	if process.args[1] == "check" then
		local expected = require("./RegressionFingerprints")
		local withForms, withoutForms = {}, {}
		for seed = 1, RegressionFights.count do
			if RegressionFights.fingerprint(seed) ~= expected[seed] then
				table.insert(if RegressionFights.hasForms(seed) then withForms else withoutForms, tostring(seed))
			end
		end
		local function list(seeds)
			return if #seeds > 0 then table.concat(seeds, ", ") else "none"
		end
		print("changed fights with a unit with forms: " .. list(withForms))
		print("changed fights without one: " .. list(withoutForms))
		process.exit(if #withoutForms > 0 then 1 else 0)
	elseif process.args[1] == "print" then
		print("-- Generated by tests/RegressionFights.luau for roster v1.1. Do not edit by hand.")
		print("return {")
		for seed = 1, RegressionFights.count do
			print(string.format('\t"%s",', RegressionFights.fingerprint(seed)))
		end
		print("}")
	end
end

return RegressionFights
