-- Applies the picker page's exported picks to the game: rewrites src/shared/UnitAvatarPicks.luau
-- (catalog asset ids only) from picks.json. Run from the repository root:
--   lune run scripts/catalog-apply                  reads docs/references/catalog/picks.json, or
--                                                   else picks.json in your Downloads folder
--   lune run scripts/catalog-apply <path to json>   reads that file
--
-- Units in picks.json replace their entry; a unit exported with no items is removed; units not in
-- the file keep their entry. Hand-tuned fields (skin, scale, weapons ...) live in UnitAvatarConfig
-- and are never touched. Afterwards it formats the file with StyLua when StyLua is on the PATH.
-- picks.json: { "<unit_id>": { "shirt": id, "pants": id, "face": id,
--                              "accessories": [ { "slot": "Hat", "id": id } ] } }

local fs = require("@lune/fs")
local luau = require("@lune/luau")
local process = require("@lune/process")
local serde = require("@lune/serde")

local PICKS_SOURCE = "src/shared/UnitAvatarPicks.luau"
local SKIN_CONFIG = "src/shared/SkinConfig.luau"
local DEFAULT_INPUT = "docs/references/catalog/picks.json"
local ACCESSORY_SLOTS = { Hat = 1, Hair = 2, Face = 3, Neck = 4, Shoulders = 5, Front = 6, Back = 7, Waist = 8 }

local HEADER = [[
-- GENERATED by scripts/catalog-apply.luau from docs/references/catalog/picks.json: the catalog
-- items each unit wears, by unit id. Do not edit by hand (the next apply rewrites it); hand-tuned
-- fields (skin, scale, weapons ...) go in UnitAvatarConfig, which merges this file in.
-- Ids are catalog asset ids. Accessory slots are HumanoidDescription slots (Hat, Hair, Face, Neck,
-- Shoulders, Front, Back, Waist); shirt and pants are classic clothing; face is a classic face.
]]

local function fail(message: string)
	print(message)
	process.exit(1)
end

local function load(path: string): any
	return luau.load(fs.readFile(path), { debugName = path })()
end

-- An asset id from JSON: a positive whole number.
local function assetId(value: any, where: string): number
	local id = tonumber(value)
	if not id or id <= 0 or id ~= math.floor(id) then
		fail(string.format("%s: %s is not a catalog asset id", where, tostring(value)))
	end
	return id :: number
end

local input = process.args[1]
if not input then
	input = DEFAULT_INPUT
	if not fs.isFile(input) then
		local home = process.env.USERPROFILE or process.env.HOME
		local downloads = if home then home .. "/Downloads/picks.json" else nil
		if downloads and fs.isFile(downloads) then
			input = downloads
		end
	end
end
if not fs.isFile(input) then
	fail("No picks file at " .. input .. ". Export picks from the picker page first.")
end
print("Reading " .. input)

local ok, exported = pcall(serde.decode, "json", fs.readFile(input))
if not ok or type(exported) ~= "table" then
	fail("Could not read " .. input .. " as JSON.")
end

-- A unit's items as one comparable string (fixed order).
local function fingerprint(entry: any?): string
	if not entry then
		return ""
	end
	local parts = { tostring(entry.shirt), tostring(entry.pants), tostring(entry.face) }
	for _, accessory in entry.accessories or {} do
		table.insert(parts, string.format("%s:%d", accessory.slot, accessory.id))
	end
	return table.concat(parts, "|")
end

local units = load(SKIN_CONFIG) -- every roster unit id
local picks = load(PICKS_SOURCE)

local changed, removed, unchanged = {}, {}, 0
for unit, pick in exported do
	if not units[unit] then
		fail("Unknown unit id " .. tostring(unit) .. " in " .. input)
	end
	local entry = { accessories = {} }
	for _, key in { "shirt", "pants", "face" } do
		if pick[key] ~= nil then
			entry[key] = assetId(pick[key], unit .. "." .. key)
		end
	end
	local seen = {}
	for index, accessory in pick.accessories or {} do
		local slot = accessory.slot
		if not ACCESSORY_SLOTS[slot] then
			fail(string.format("%s: accessory %d has unknown slot %s", unit, index, tostring(slot)))
		end
		local id = assetId(accessory.id, unit .. ".accessories")
		if not seen[id] then
			seen[id] = true
			table.insert(entry.accessories, { slot = slot, id = id })
		end
	end
	table.sort(entry.accessories, function(a, b)
		if a.slot ~= b.slot then
			return ACCESSORY_SLOTS[a.slot] < ACCESSORY_SLOTS[b.slot]
		end
		return a.id < b.id
	end)

	local empty = #entry.accessories == 0 and not entry.shirt and not entry.pants and not entry.face
	local before = picks[unit]
	if empty then
		if before then
			picks[unit] = nil
			table.insert(removed, unit)
		end
	else
		if #entry.accessories == 0 then
			entry.accessories = nil
		end
		if fingerprint(before) == fingerprint(entry) then
			unchanged += 1
		else
			table.insert(changed, unit)
		end
		picks[unit] = entry
	end
end

-- Write the file: units sorted by id, fields in a fixed order (as StyLua would format it).
local lines = { HEADER, "return {" }
local ids = {}
for unit in picks do
	table.insert(ids, unit)
end
table.sort(ids)
for _, unit in ids do
	local entry = picks[unit]
	table.insert(lines, "\t" .. unit .. " = {")
	if entry.accessories and #entry.accessories > 0 then
		table.insert(lines, "\t\taccessories = {")
		for _, accessory in entry.accessories do
			table.insert(lines, string.format('\t\t\t{ slot = "%s", id = %d },', accessory.slot, accessory.id))
		end
		table.insert(lines, "\t\t},")
	end
	for _, key in { "shirt", "pants", "face" } do
		if entry[key] then
			table.insert(lines, string.format("\t\t%s = %d,", key, entry[key]))
		end
	end
	table.insert(lines, "\t},")
end
table.insert(lines, "}")
fs.writeFile(PICKS_SOURCE, table.concat(lines, "\n") .. "\n")

local formatted = pcall(process.exec, "stylua", { PICKS_SOURCE })
table.sort(changed)
table.sort(removed)
print(string.format("Wrote %s: %d units with avatars.", PICKS_SOURCE, #ids))
print("  changed: " .. (if #changed > 0 then table.concat(changed, ", ") else "none"))
print("  removed: " .. (if #removed > 0 then table.concat(removed, ", ") else "none"))
print("  unchanged: " .. unchanged)
if not formatted then
	print("  (StyLua not found on the PATH; run `stylua " .. PICKS_SOURCE .. "` to format it.)")
end
print("Next: check the units in Studio with the dev lineup (L, then . and , for close-ups).")
